PORT=5000
NODE_ENV=development
SERVERLESS=false

MONGO_URI=mongodb://127.0.0.1:27017/authentication_system

CLIENT_URL=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

VERIFICATION_CODE_SECRET=replace_with_a_different_long_random_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-project-email@gmail.com
SMTP_PASS=replace_with_gmail_app_password

EMAIL_FROM_NAME=Authentication System
EMAIL_FROM_ADDRESS=your-project-email@gmail.com